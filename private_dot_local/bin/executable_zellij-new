#!/usr/bin/env bash
# zellij-new: start a fresh zellij session in the least recently used Code/
# slot on cominor, named sN after the slot (/home/mmcelvain/Code is s1,
# /home/mmcelvain-N/Code is sN), with the sh-hx-claude layout. Attaches from a
# plain shell and switches from inside a session; aliased to `zn`.
#
# A slot's last use is when its git index was last written: checkouts,
# commits, staging and the prompt's own `git status` all touch it, and it's
# per-worktree, unlike the shared refs. Slots that a live session is rooted in
# are skipped, so a new session never lands on work in progress.
#
# `zellij-new BRANCH` starts the session with BRANCH checked out, fetching it
# from origin if it only exists there. A free slot that already holds the
# branch is reused as-is; otherwise the least recently used clean slot
# switches to it. zellij-sessions' b key calls this once it has found no
# session already on the branch.

set -uo pipefail
shopt -s nullglob

SLOT_GLOB=${ZN_SLOTS:-/home/mmcelvain*/Code}
LAYOUT=sh-hx-claude

die() {
    echo "zellij-new: $*" >&2
    exit 1
}

# /home/mmcelvain/Code -> 1, /home/mmcelvain-4/Code -> 4
slot_num() {
    local parent=${1%/*}
    parent=${parent##*/}
    case $parent in
        *-[0-9]) printf '%s' "${parent##*-}" ;;
        *) printf 1 ;;
    esac
}

# Where zellij keeps per-session layouts; see zellij-sessions for why it's
# globbed.
find_info_dir() {
    local d best='' t newest=0
    for d in "${XDG_CACHE_HOME:-$HOME/.cache}"/zellij/*/session_info; do
        t=$(stat -c %Y "$d" 2>/dev/null) || continue
        if ((t > newest)); then
            newest=$t
            best=$d
        fi
    done
    printf '%s' "$best"
}

# Prints the name and real cwd of every live session, one per line each. A
# session zellij hasn't written to its cache yet (a few seconds old) has only
# its name, which still marks an sN's slot busy.
live_sessions() {
    local info line name
    info=$(find_info_dir)
    while IFS= read -r line; do
        [[ -z $line || $line == *EXITED* ]] && continue
        name=${line%% *}
        printf '%s\n' "$name"
        [ -n "$info" ] || continue
        line=$(grep -m1 -E '^[[:space:]]*cwd ' "$info/$name/session-layout.kdl" 2>/dev/null) || continue
        line=${line#*\"}
        realpath -m -- "${line%\"*}"
    done < <(zellij list-sessions -n 2>/dev/null)
}

# Prints every slot that no live session is rooted in, least recently used
# first.
free_slots() {
    local busy slot real gitdir stamp
    busy=$(live_sessions)
    for slot in $SLOT_GLOB; do
        [ -d "$slot" ] || continue
        real=$(realpath -- "$slot")
        grep -qxF -e "$real" -e "s$(slot_num "$slot")" <<<"$busy" && continue
        gitdir=$(git -C "$slot" rev-parse --absolute-git-dir 2>/dev/null) &&
            stamp=$(stat -c %Y "$gitdir/index" 2>/dev/null) ||
            stamp=$(stat -c %Y "$slot")
        printf '%s %s\n' "$stamp" "$slot"
    done | sort -n | cut -d' ' -f2-
}

# Dies unless branch $2 exists in repo $1, locally or on origin. Only a branch
# that isn't local is fetched, so the common case stays offline; fetching it
# also refreshes a stale remote-tracking ref before the switch copies it.
ensure_branch() {
    git -C "$1" check-ref-format --branch "$2" >/dev/null 2>&1 ||
        die "$2 isn't a valid branch name"
    git -C "$1" show-ref -q --verify "refs/heads/$2" && return 0
    git -C "$1" fetch -q origin "+refs/heads/$2:refs/remotes/origin/$2" >/dev/null 2>&1 ||
        die "no branch $2, here or on origin"
}

# Prints the worktree that has branch $2 checked out, if any. git refuses to
# check a branch out twice, so that's the only place it can go.
branch_worktree() {
    local line path=''
    while IFS= read -r line; do
        case $line in
            'worktree '*) path=${line#worktree } ;;
            "branch refs/heads/$2")
                realpath -m -- "$path"
                return 0
                ;;
        esac
    done < <(git -C "$1" worktree list --porcelain 2>/dev/null)
}

# Prints a free slot with branch $1 checked out, switching one over if none
# has it. A dirty slot is passed over rather than switched, since the switch
# could carry its changes onto the wrong branch or refuse outright.
branch_slot() {
    local branch=$1 slots repo held slot err
    slots=$(free_slots)
    [ -n "$slots" ] || die 'every Code slot has a live session in it'
    repo=${slots%%$'\n'*}
    ensure_branch "$repo" "$branch"

    held=$(branch_worktree "$repo" "$branch")
    if [ -n "$held" ]; then
        while IFS= read -r slot; do
            [ "$(realpath -- "$slot")" = "$held" ] && printf '%s' "$slot" && return 0
        done <<<"$slots"
        die "$branch is checked out in $held, which isn't a free Code slot"
    fi

    while IFS= read -r slot; do
        [ -z "$(git --no-optional-locks -C "$slot" status --porcelain -uno 2>/dev/null)" ] ||
            continue
        err=$(git -C "$slot" switch -q "$branch" 2>&1) ||
            die "couldn't check out $branch in $slot: ${err%%$'\n'*}"
        printf '%s' "$slot"
        return 0
    done <<<"$slots"
    die 'every free Code slot has uncommitted changes'
}

main() {
    command -v zellij >/dev/null || die 'zellij is not installed'

    local branch=${1:-} slot name
    if [ -n "$branch" ]; then
        slot=$(branch_slot "$branch") || exit 1
    else
        slot=$(free_slots | head -n1)
        [ -n "$slot" ] || die 'every Code slot has a live session in it'
    fi
    name=s$(slot_num "$slot")

    # The slot has no live session, so an sN still listed is an exited one,
    # which attach would resurrect instead of starting fresh.
    if zellij list-sessions -n 2>/dev/null | grep -qE "^$name( |$)"; then
        zellij delete-session "$name" >/dev/null 2>&1 ||
            die "couldn't clear the old $name session"
    fi

    # Inside zellij, these would point the new session's client at this one.
    # The layout's `cwd "."` resolves against where zellij starts, hence the cd.
    (cd "$slot" && env -u ZELLIJ -u ZELLIJ_SESSION_NAME -u ZELLIJ_PANE_ID \
        zellij attach --create-background "$name" options --default-layout "$LAYOUT") \
        >/dev/null 2>&1 || die "couldn't create $name in $slot"

    echo "zellij-new: $name in $slot${branch:+ on $branch}"
    if [ -z "${ZELLIJ:-}" ]; then
        exec zellij attach "$name"
    fi
    zellij action switch-session "$name" >/dev/null 2>&1 ||
        die "created $name but couldn't switch to it"
}

main "$@"
