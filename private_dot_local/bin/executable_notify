#!/usr/bin/env bash
# notify -- send a desktop notification.
#
#   notify 'Claude Code' 'Task completed'
#   notify -u critical '✗ cargo build' 'exit 1 · 4m12s · masons-xps:~/Code'
#   notify -n claude-desktop 'Claude Code' 'Task completed'
#
# Sent through notify-relay when it's running, so popups stack in GNOME, and
# through notify-send when it isn't. On macOS it goes through osascript, and
# only the title and body are used.
#
# Callers: `yo` (slow-command notifications) and the Claude Code hooks
# registered by dot_claude/modify_settings.json.
#
# Exits 0 if the notification went out, 1 if it didn't.

set -uo pipefail

prog=${0##*/}

usage() {
    cat <<EOF
usage: $prog [options] <title> [body]

  -u LEVEL  low | normal | critical  (default normal)
  -i ICON   desktop body icon (default none)
  -n ICON   desktop header icon, beside the app name, e.g. Alacritty
  -a NAME   application name (default $prog)
  -h        this help
EOF
}

# A desktop session is only reachable when there's a bus to talk to. Checking
# for the bus, rather than just the binary, keeps notify-send from failing
# noisily over ssh, where the binary may exist but there's no session at all.
has_desktop() {
    command -v notify-send >/dev/null || return 1
    [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] ||
        [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus" ]
}

urgency=normal icon='' appicon='' appname=$prog

while getopts ':u:i:n:a:h' opt; do
    case $opt in
        u) urgency=$OPTARG ;;
        i) icon=$OPTARG ;;
        n) appicon=$OPTARG ;;
        a) appname=$OPTARG ;;
        h)
            usage
            exit 0
            ;;
        :)
            printf '%s: -%s needs an argument\n' "$prog" "$OPTARG" >&2
            exit 2
            ;;
        *)
            printf '%s: unknown option -%s\n' "$prog" "$OPTARG" >&2
            usage >&2
            exit 2
            ;;
    esac
done
shift $((OPTIND - 1))

case $urgency in
    low | normal | critical) ;;
    *)
        printf '%s: -u wants low, normal or critical\n' "$prog" >&2
        exit 2
        ;;
esac

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
    usage >&2
    exit 2
fi

title=$1
body=${2:-}

# macOS. The notification is attributed to Script Editor, which needs
# notifications allowed in System Settings the first time.
if command -v osascript >/dev/null; then
    osascript \
        -e 'on run argv' \
        -e 'display notification (item 2 of argv) with title (item 1 of argv)' \
        -e 'end run' \
        "$title" "$body" >/dev/null 2>&1
    exit
fi

if ! has_desktop; then
    printf '%s: no desktop session to notify\n' "$prog" >&2
    exit 1
fi

# GNOME Shell arms its banner timer only for non-critical notifications
# (messageTray.js: NOTIFICATION_TIMEOUT = 4000, skipped when urgency is
# CRITICAL), and ignores expire_timeout entirely -- so -u critical means
# "sit on screen until clicked", not "shout louder". Cap the desktop at
# normal and let the title's glyph carry the severity.
[ "$urgency" = critical ] && urgency=normal
# No body icon by default: GNOME 50 renders -i as a large image beside
# the text, where Chrome's popups have only a small icon in the header.
# That header icon is -n. A desktop-entry hint would also set it, but it
# ties the notification to an app, and GNOME destroys an app's
# notifications once their sender leaves the bus (notificationDaemon.js,
# _onNameVanished) -- which notify-send does the moment it returns.
args=(-a "$appname" -u "$urgency")
[ -n "$icon" ] && args+=(-i "$icon")
[ -n "$appicon" ] && args+=(-n "$appicon")
# notify-relay takes the same flags, but sends from one long-lived
# process, which is what lets GNOME stack the popups per app name.
# notify-send still delivers when the relay isn't running, just unstacked.
relay=${0%/*}/notify-relay
[ -x "$relay" ] || relay=notify-relay
{ "$relay" "${args[@]}" "$title" "$body" ||
    notify-send "${args[@]}" "$title" "$body"; } 2>/dev/null
