#!/usr/bin/osascript -l JavaScript
// window-size fill|restore - resize the focused window (Mac only, run by skhd).
//
// fill covers the screen's visible area (minus the menu bar and Dock) without
// making the window a full-screen app in its own Space. restore puts a filled
// window back where it was; any other window shrinks to a centered two-thirds
// of the screen.
//
// Both zoom the window the way double-clicking its title bar does, through the
// green button's AXZoomWindow action, so the app animates it and remembers the
// frame to go back to. Setting the frame over the Accessibility API instead
// jumps in steps, so that's only the fallback, for a window with no zoom button
// or an app whose zoom doesn't fill the screen (Safari's fits the page).

ObjC.import('AppKit');

function run(argv) {
  const mode = argv[0];
  if (mode !== 'fill' && mode !== 'restore') {
    throw new Error('usage: window-size fill|restore');
  }

  const proc = Application('System Events').processes.whose({ frontmost: true })[0];
  const win = proc.attributes.byName('AXFocusedWindow').value();
  if (!win) return;

  const screen = visibleFrame(frame(win));
  const filled = close(frame(win), screen);

  if (mode === 'fill') {
    if (filled) return;
    if (!zoom(win) || !close(frame(win), screen)) setFrame(win, screen);
    return;
  }

  // A window filled without zooming has no frame to go back to, and zooming
  // it leaves it about the same size.
  if (filled && zoom(win) && !close(frame(win), screen)) return;
  const [x, y, w, h] = screen;
  const sw = Math.round(w * 2 / 3);
  const sh = Math.round(h * 2 / 3);
  setFrame(win, [x + Math.round((w - sw) / 2), y + Math.round((h - sh) / 2), sw, sh]);
}

function frame(win) {
  return [...win.position(), ...win.size()];
}

// Zooms the window as a title bar double-click would, returning false when it
// has no zoom button. The green button is AXFullScreenButton, whose AXPress
// goes full screen, unless the window can't go full screen.
function zoom(win) {
  for (const b of win.buttons()) {
    let sub;
    try { sub = b.subrole(); } catch { continue; }
    if (sub === 'AXFullScreenButton') {
      b.actions.byName('AXZoomWindow').perform();
      return true;
    }
    if (sub === 'AXZoomButton') {
      b.actions.byName('AXPress').perform();
      return true;
    }
  }
  return false;
}

// The visible frame, in Accessibility's top-left coordinates, of the screen
// holding the window's center. NSScreen measures up from the primary screen's
// bottom edge.
function visibleFrame([x, y, w, h]) {
  const screens = $.NSScreen.screens.js;
  const top = screens[0].frame.size.height;
  const flip = (r) => [r.origin.x, top - r.origin.y - r.size.height, r.size.width, r.size.height];
  const cx = x + w / 2;
  const cy = y + h / 2;
  const s = screens.find((s) => {
    const [sx, sy, sw, sh] = flip(s.frame);
    return cx >= sx && cx < sx + sw && cy >= sy && cy < sy + sh;
  }) || $.NSScreen.mainScreen;
  return flip(s.visibleFrame);
}

// Apps round sizes to their own increments (Alacritty to whole cells), so a
// frame is compared with some slack.
function close(a, b) {
  return a.every((v, i) => Math.abs(v - b[i]) <= 24);
}

// Size before and after moving, since a window too big for its new spot, or
// one moving to another screen, can be clamped on the first try.
function setFrame(win, [x, y, w, h]) {
  win.size = [w, h];
  win.position = [x, y];
  win.size = [w, h];
}
