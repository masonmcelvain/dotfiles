#!/usr/bin/env bash
# zellij-sessions: picker for zellij sessions, listing each session's git
# branch and working directory alongside its name. Attaches from a plain shell
# and switches from inside a session, so it works either way; aliased to `zf`
# and bound to Alt+f as a floating pane in ~/.config/zellij/config.kdl.
# Keys: picker.sh's, plus d to delete a session (killing it first if it's
# live), b to go to a branch, and, where zellij-new is installed (cominor), n
# to start a fresh one. With stdout not a TTY, prints a plain table instead.
#
# `zellij-sessions branch NAME` (or `b NAME`; aliased to `zb`) does what the b
# key does without the picker: goes to the session that has branch NAME
# checked out, preferring a live one, or else has zellij-new start a session
# on it, which errors if the branch exists neither locally nor on origin.
# Without zellij-new, a branch with no session is an error.
#
# Session cwds come from zellij's own on-disk session info rather than from
# `zellij action dump-layout`: dump-layout needs a running server per session
# and hangs on exited ones, while the cache covers live and exited alike
# without spawning anything. Branches are read straight out of .git/HEAD for
# the same reason -- a `git` per session is the one thing that would make this
# feel slow.

set -uo pipefail
shopt -s nullglob

# shellcheck source=picker.sh
source "$(dirname "${BASH_SOURCE[0]}")/picker.sh"

SEP=$'\x1f'

PICKER_TITLE=sessions
HAS_NEW=''
command -v zellij-new >/dev/null && HAS_NEW=1
PICKER_HELP="1-9 jump · j/k move · enter open · b branch${HAS_NEW:+ · n new} · d delete · q quit"
PICKER_EMPTY='no other sessions'
PICKER_DETAIL_LINES=2

C_GREEN=$'\e[32m' C_ORANGE=$'\e[38;5;208m'

# Where zellij keeps per-session layout/metadata. The parent is a contract
# version ("contract_version_1") that changed from plain version numbers in
# earlier releases, so glob it and take the freshest rather than hardcoding.
find_info_dir() {
    local d best='' t newest=0
    for d in "${XDG_CACHE_HOME:-$HOME/.cache}"/zellij/*/session_info; do
        [ -d "$d" ] || continue
        t=$(stat -c %Y "$d" 2>/dev/null) || continue
        if ((t > newest)); then
            newest=$t
            best=$d
        fi
    done
    printf '%s' "$best"
}

INFO_DIR=$(find_info_dir)

# The session layout carries exactly one top-level `cwd`; every pane inherits
# it, which is what makes "the session's directory" a well-defined thing.
session_cwd() {
    local line
    [ -n "$INFO_DIR" ] || return 0
    line=$(grep -m1 -E '^[[:space:]]*cwd ' \
        "$INFO_DIR/$1/session-layout.kdl" 2>/dev/null) || return 0
    line=${line#*\"}
    printf '%s' "${line%\"*}"
}

# When a session exits, zellij stops rewriting its metadata -- so the mtime is
# when it was last used. Live sessions all share a rewrite tick, so their
# mtimes are identical and useless; those fall back to their creation age.
session_mtime() {
    [ -n "$INFO_DIR" ] || return 0
    stat -c %Y "$INFO_DIR/$1/session-metadata.kdl" 2>/dev/null
}

# Walk up for a .git, then read HEAD. Handles worktrees and submodules, where
# .git is a file pointing elsewhere, and detached HEADs, which get a short sha.
git_branch() {
    local dir=$1 gitdir head
    [ -n "$dir" ] || return 0
    while [ -n "$dir" ]; do
        [ -e "$dir/.git" ] && break
        dir=${dir%/*}
    done
    [ -n "$dir" ] && [ -e "$dir/.git" ] || return 0

    gitdir=$dir/.git
    if [ -f "$gitdir" ]; then
        read -r _ gitdir <"$dir/.git" 2>/dev/null || return 0
        [[ $gitdir == /* ]] || gitdir=$dir/$gitdir
    fi
    read -r head <"$gitdir/HEAD" 2>/dev/null || return 0

    case $head in
        "ref: refs/heads/"*) printf '%s' "${head#ref: refs/heads/}" ;;
        "ref: "*) printf '%s' "${head#ref: }" ;;
        ?*) printf '%s' "${head:0:7}" ;;
    esac
}

# "3days 1h 24m 8s" (zellij's own phrasing) -> seconds.
dur_to_secs() {
    local tok n unit total=0
    for tok in $1; do
        n=${tok%%[!0-9]*}
        [ -n "$n" ] || continue
        unit=${tok#"$n"}
        case $unit in
            s | sec | secs) total=$((total + n)) ;;
            m | min | mins) total=$((total + n * 60)) ;;
            h | hour | hours) total=$((total + n * 3600)) ;;
            d | day | days) total=$((total + n * 86400)) ;;
            w | week | weeks) total=$((total + n * 604800)) ;;
            month | months) total=$((total + n * 2592000)) ;;
            y | year | years) total=$((total + n * 31536000)) ;;
        esac
    done
    printf '%s' "$total"
}

# Fields, SEP-separated: 1 name  2 live|exited  3 branch  4 cwd  5 age
ROWS=()

collect() {
    local line name age cwd branch now live=() dead=()
    now=$(date +%s)

    # -r sorts newest first, which is the order we want for live sessions.
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        name=${line%% *}
        [ -n "$name" ] || continue
        # Switching to the session you are already in is a no-op; skip it.
        [ "$name" = "${ZELLIJ_SESSION_NAME:-}" ] && continue

        cwd=$(session_cwd "$name")
        branch=$(git_branch "$cwd")

        if [[ $line == *EXITED* ]]; then
            local mtime
            mtime=$(session_mtime "$name")
            if [ -n "$mtime" ]; then
                age=$(age_str $((now - mtime)))
            else
                age=$(age_str "$(dur_to_secs "${line#*\[Created }")")
            fi
            dead+=("${mtime:-0}${SEP}${name}${SEP}exited${SEP}${branch}${SEP}${cwd}${SEP}${age}")
        else
            age=${line#*\[Created }
            age=$(age_str "$(dur_to_secs "${age%% ago\]*}")")
            live+=("${name}${SEP}live${SEP}${branch}${SEP}${cwd}${SEP}${age}")
        fi
    done < <(zellij list-sessions -rn 2>/dev/null)

    ROWS=("${live[@]}")
    # Exited sessions sort by when they exited, most recently used first.
    if ((${#dead[@]} > 0)); then
        while IFS= read -r line; do
            ROWS+=("${line#*"$SEP"}")
        done < <(printf '%s\n' "${dead[@]}" | sort -t "$SEP" -k1,1nr)
    fi
}

picker_load() {
    collect
    PICKER_N=${#ROWS[@]}
}

picker_render() {
    local row name state branch cwd age i
    local name_w=4 branch_w=6 path_w=8 avail over give

    # Start every column at the width its longest value wants.
    for row in "${ROWS[@]}"; do
        IFS=$SEP read -r name _ branch cwd _ <<<"$row"
        cwd=${cwd/#$HOME/\~}
        ((${#name} > name_w)) && name_w=${#name}
        ((${#branch} > branch_w)) && branch_w=${#branch}
        ((${#cwd} > path_w)) && path_w=${#cwd}
    done

    # Leave room for the gaps, the age column and a spare column at the edge.
    avail=$(($1 - 12))

    # Only claw width back when the natural widths don't fit -- on a wide
    # terminal nothing is truncated. The path yields first, then the branch,
    # then the name: the branch is the thing worth reading here, and a
    # truncated name stops identifying the session at all.
    over=$((name_w + branch_w + path_w - avail))
    if ((over > 0)); then
        give=$((path_w - 12))
        ((give > over)) && give=$over
        ((give > 0)) && {
            path_w=$((path_w - give))
            over=$((over - give))
        }
    fi
    if ((over > 0)); then
        give=$((branch_w - 12))
        ((give > over)) && give=$over
        ((give > 0)) && {
            branch_w=$((branch_w - give))
            over=$((over - give))
        }
    fi
    if ((over > 0)); then
        give=$((name_w - 8))
        ((give > over)) && give=$over
        ((give > 0)) && {
            name_w=$((name_w - give))
            over=$((over - give))
        }
    fi
    # Narrower than every floor combined: let the path absorb the remainder.
    ((over > 0)) && path_w=$((path_w - over))
    ((path_w < 4)) && path_w=4

    for ((i = 0; i < PICKER_N; i++)); do
        IFS=$SEP read -r name state branch cwd age <<<"${ROWS[i]}"
        local dim='' line
        [ "$state" = exited ] && dim=$C_DIM && PICKER_DIM[i]=1
        line="$(fit "$name" "$name_w")  "
        line+="${C_GREEN}${dim}$(fit "$branch" "$branch_w")${C_RESET}${dim}  "
        line+="${C_DIM}$(fit "${cwd/#$HOME/\~}" "$path_w")${C_RESET}${dim}  "
        if [ "$state" = exited ]; then
            line+="${C_DIM}$(printf '%5s' "$age")"
        else
            line+="${C_ORANGE}$(printf '%5s' "$age")"
        fi
        PICKER_ROWS[i]=$line
    done
}

picker_detail() {
    local state cwd age
    IFS=$SEP read -r _ state _ cwd age <<<"${ROWS[$1]}"
    PICKER_DETAIL=("$(fit "${cwd/#$HOME/\~}" "$2")")
    if [ "$state" = exited ]; then
        PICKER_DETAIL+=("${C_DIM}exited ${age} ago · enter resurrects it")
    else
        PICKER_DETAIL+=("${C_DIM}live · created ${age} ago")
    fi
}

plain_list() {
    local row name state branch cwd age
    {
        for row in "${ROWS[@]}"; do
            IFS=$SEP read -r name state branch cwd age <<<"$row"
            printf '%s\t%s\t%s\t%s\t%s\n' \
                "$name" "${branch:--}" "${cwd/#$HOME/\~}" "$age" "$state"
        done
    } | column -t -s$'\t' 2>/dev/null || true
}

# Lands this terminal in session $1. Outside zellij, attaches, which resurrects
# an exited session. Inside, detaches this client from the current session
# (leaving it running) and lands it in the target, resurrecting it too.
switch_to() {
    [ -z "${ZELLIJ:-}" ] && exec zellij attach "$1"
    zellij action switch-session "$1" >/dev/null 2>&1
}

open_session() {
    [ -z "${ZELLIJ:-}" ] && picker_cleanup
    if switch_to "$1"; then
        PICKER_QUIT=1
    else
        PICKER_FLASH="couldn't switch to $1"
    fi
}

picker_open() {
    local name
    IFS=$SEP read -r name _ <<<"${ROWS[$1]}"
    open_session "$name"
}

# Prints the session with branch $1 checked out. ROWS lists live sessions
# first, then exited ones by last use, so the first match is the best one. The
# current session isn't in ROWS, but standing in it already counts.
branch_session() {
    local row name branch
    if [ -n "${ZELLIJ_SESSION_NAME:-}" ] &&
        [ "$(git_branch "$(session_cwd "$ZELLIJ_SESSION_NAME")")" = "$1" ]; then
        printf '%s' "$ZELLIJ_SESSION_NAME"
        return 0
    fi
    for row in "${ROWS[@]}"; do
        IFS=$SEP read -r name _ branch _ <<<"$row"
        [ "$branch" = "$1" ] && printf '%s' "$name" && return 0
    done
    return 1
}

# Detaches HEAD in a deleted session's checkout so its branch is free to check
# out in another worktree; git refuses a branch that any worktree holds. The
# commit and files stay put. Prints why it didn't, if it didn't.
#
# A dirty tree keeps its branch: detaching would strand the uncommitted work
# away from the branch it belongs to. The index mtime is put back afterwards
# because zellij-new reads it as the slot's last use, and an abandoned slot
# shouldn't look like the freshest one.
release_branch() {
    local name=$1 cwd=$2 branch=$3 row other state ocwd gitdir stamp
    [ -n "$branch" ] && [ -d "$cwd" ] || return 0

    # Another live session in the same checkout is still using the branch.
    for row in "${ROWS[@]}"; do
        IFS=$SEP read -r other state _ ocwd _ <<<"$row"
        [ "$other" != "$name" ] && [ "$state" = live ] && [ "$ocwd" = "$cwd" ] &&
            return 0
    done
    [ -n "${ZELLIJ_SESSION_NAME:-}" ] &&
        [ "$(session_cwd "$ZELLIJ_SESSION_NAME")" = "$cwd" ] && return 0

    git -C "$cwd" symbolic-ref -q HEAD >/dev/null || return 0
    # --no-optional-locks keeps status from refreshing (and touching) the index.
    if [ -n "$(git --no-optional-locks -C "$cwd" status --porcelain 2>/dev/null)" ]; then
        printf '%s still checked out (uncommitted changes)' "$branch"
        return 0
    fi

    gitdir=$(git -C "$cwd" rev-parse --absolute-git-dir 2>/dev/null) || return 0
    stamp=$(stat -c %Y "$gitdir/index" 2>/dev/null)
    if ! git -C "$cwd" switch -q --detach >/dev/null 2>&1; then
        printf "couldn't release %s" "$branch"
        return 0
    fi
    [ -n "$stamp" ] && touch -d "@$stamp" "$gitdir/index" 2>/dev/null
    return 0
}

delete_session() {
    local name state branch cwd note
    IFS=$SEP read -r name state branch cwd _ <<<"${ROWS[$1]}"
    if [ "$state" = live ]; then
        picker_ask "kill and delete $name? y yes · else no"
    else
        picker_ask "delete $name? y yes · else no"
    fi
    [ "$PICKER_ANSWER" = y ] || return 0

    # --force kills a live session first; without it zellij refuses one.
    if zellij delete-session --force "$name" >/dev/null 2>&1; then
        note=$(release_branch "$name" "$cwd" "$branch")
        PICKER_FLASH="deleted $name${note:+ · $note}"
    else
        PICKER_FLASH="couldn't delete $name"
    fi
    picker_reload
}

# Runs zellij-new with any branch in $1.
new_session() {
    if [ -z "${ZELLIJ:-}" ]; then
        # zellij-new attaches itself, so hand it the terminal.
        picker_cleanup
        exec zellij-new "$@"
    fi
    # Inside, it switches this client over and returns; keep its error.
    local err
    if err=$(zellij-new "$@" 2>&1 >/dev/null); then
        PICKER_QUIT=1
    else
        PICKER_FLASH=${err#zellij-new: }
    fi
}

branch_key() {
    local branch name
    picker_read 'branch: '
    read -r branch <<<"$PICKER_ANSWER"
    [ -n "$branch" ] || return 0

    if name=$(branch_session "$branch"); then
        if [ "$name" = "${ZELLIJ_SESSION_NAME:-}" ]; then
            PICKER_FLASH="already in $name, on $branch"
        else
            open_session "$name"
        fi
    elif [ -n "$HAS_NEW" ]; then
        # Checking the branch can mean a fetch; say so rather than look hung.
        PICKER_FLASH="starting a session on $branch…"
        picker_draw
        PICKER_FLASH=''
        new_session "$branch"
    else
        PICKER_FLASH="no session has $branch checked out"
    fi
}

picker_key() {
    case $1 in
        b) branch_key ;;
        d) ((PICKER_N > 0)) && delete_session "$PICKER_SEL" ;;
        n) [ -n "$HAS_NEW" ] && new_session ;;
    esac
}

die() {
    echo "zellij-sessions: $*" >&2
    exit 1
}

branch_cli() {
    local name
    collect
    if name=$(branch_session "$1"); then
        if [ "$name" = "${ZELLIJ_SESSION_NAME:-}" ]; then
            echo "zellij-sessions: already in $name, on $1"
            return 0
        fi
        switch_to "$name" || die "couldn't switch to $name"
    elif [ -n "$HAS_NEW" ]; then
        exec zellij-new "$1"
    else
        die "no session has $1 checked out"
    fi
}

main() {
    command -v zellij >/dev/null || die 'zellij is not installed'
    case ${1:-} in
        '') ;;
        b | branch)
            [ -n "${2:-}" ] || die "usage: zellij-sessions $1 BRANCH"
            branch_cli "$2"
            return
            ;;
        *) die "unknown command $1; try branch BRANCH" ;;
    esac
    if [ ! -t 1 ]; then
        collect
        plain_list
        return 0
    fi
    picker_run
}

main "$@"
