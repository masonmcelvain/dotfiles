#!/usr/bin/env bash
# yo -- run a slow command and get notified when it finishes, so you can
# wander off to another pane instead of babysitting it.
#
#   yo make -j8
#   yo -c 'pnpm build | tee build.log'     # a whole shell line
#   yo -w 31337                            # attach to something already running
#
# Delivery is `notify`'s problem -- desktop popup on a machine with a session
# bus, ntfy push on one without. What yo adds on top is the terminal bell,
# which zellij renders as a [!] flag on the tab the command ran in.
#
# yo exits with the status of the command it ran, so it composes:
#   yo cargo test && yo ./deploy.sh

set -uo pipefail

prog=${0##*/}

# Prefer the notify sitting next to this script, so a yo run by absolute path
# out of a hook or a cron entry doesn't depend on PATH being set up.
notify=${0%/*}/notify
[ -x "$notify" ] || notify=notify

usage() {
    cat <<EOF
usage: $prog [options] <command> [args...]
       $prog [options] -c '<shell line>'
       $prog [options] -w <pid>

Run a command and send a notification when it finishes.

  -c LINE   run LINE with \$SHELL -c, so pipes and redirects work
  -w PID    don't run anything; wait for an existing process to exit
  -m LABEL  label the notification with LABEL instead of the command
  -t SECS   only notify if the command ran at least SECS seconds
  -p        push to ntfy even when a desktop notification also went out
  -q        no terminal bell
  -h        this help

Exits with the status of the command (0 when -w is used, since the exit
status of a process you don't own isn't observable).
EOF
}

# 12s / 4m12s / 1h04m -- humans don't need seconds past the hour mark.
fmt_duration() {
    local s=$1
    if ((s < 60)); then
        printf '%ds' "$s"
    elif ((s < 3600)); then
        printf '%dm%02ds' $((s / 60)) $((s % 60))
    else
        printf '%dh%02dm' $((s / 3600)) $((s % 3600 / 60))
    fi
}

truncate_label() {
    local s=$1 max=${2:-60}
    if [ "${#s}" -gt "$max" ]; then
        printf '%s…' "${s:0:max-1}"
    else
        printf '%s' "$s"
    fi
}

# push holds the flag itself rather than a boolean, so it can be spliced into
# the notify call as either "-p" or nothing at all.
shell_line='' wait_pid='' label='' threshold=0 push='' bell=1

while getopts ':c:w:m:t:pqh' opt; do
    case $opt in
        c) shell_line=$OPTARG ;;
        w) wait_pid=$OPTARG ;;
        m) label=$OPTARG ;;
        t) threshold=$OPTARG ;;
        p) push=-p ;;
        q) bell=0 ;;
        h)
            usage
            exit 0
            ;;
        :)
            printf '%s: -%s needs an argument\n' "$prog" "$OPTARG" >&2
            exit 2
            ;;
        *)
            printf '%s: unknown option -%s\n' "$prog" "$OPTARG" >&2
            usage >&2
            exit 2
            ;;
    esac
done
shift $((OPTIND - 1))

if ! [[ $threshold =~ ^[0-9]+$ ]]; then
    printf '%s: -t wants a whole number of seconds\n' "$prog" >&2
    exit 2
fi

start=$SECONDS
status=0

if [ -n "$wait_pid" ]; then
    if [ -n "$shell_line" ] || [ $# -gt 0 ]; then
        printf '%s: -w takes no command\n' "$prog" >&2
        exit 2
    fi
    if ! [[ $wait_pid =~ ^[0-9]+$ ]] || ! kill -0 "$wait_pid" 2>/dev/null; then
        printf '%s: no such running process: %s\n' "$prog" "$wait_pid" >&2
        exit 2
    fi
    [ -n "$label" ] || label=$(ps -o args= -p "$wait_pid" 2>/dev/null | head -1)
    [ -n "$label" ] || label="pid $wait_pid"
    # Polling, not `wait`: the target is usually not a child of this shell.
    while kill -0 "$wait_pid" 2>/dev/null; do sleep 1; done
elif [ -n "$shell_line" ]; then
    [ $# -eq 0 ] || {
        printf '%s: -c takes the whole command as one argument\n' "$prog" >&2
        exit 2
    }
    [ -n "$label" ] || label=$shell_line
    "${SHELL:-/bin/bash}" -c "$shell_line"
    status=$?
elif [ $# -gt 0 ]; then
    [ -n "$label" ] || label="$*"
    "$@"
    status=$?
else
    usage >&2
    exit 2
fi

elapsed=$((SECONDS - start))
((elapsed >= threshold)) || exit "$status"

duration=$(fmt_duration "$elapsed")
where="$(hostname -s):${PWD/#$HOME/\~}"

if [ -n "$wait_pid" ]; then
    # Nothing to report but the fact that it's over: the exit status of a
    # process this shell didn't spawn isn't ours to read.
    glyph='✓' urgency=normal tags=white_check_mark
    detail="finished after $duration · $where"
elif [ "$status" -eq 0 ]; then
    glyph='✓' urgency=normal tags=white_check_mark
    detail="$duration · $where"
else
    glyph='✗' urgency=critical tags=x
    detail="exit $status · $duration · $where"
fi

# $push is deliberately unquoted: empty must expand to no argument at all.
# shellcheck disable=SC2086
"$notify" $push -a "$prog" -u "$urgency" -t "$tags" \
    "$glyph $(truncate_label "$label")" "$detail"

[ "$bell" = 1 ] && printf '\a' >/dev/tty 2>/dev/null

exit "$status"
