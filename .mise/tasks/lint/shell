#!/usr/bin/env bash
#MISE description="Shellcheck every shell script, rendering templates for each host"
# Plain scripts are found by shebang rather than extension, since most of
# them have none. Templates aren't shell until chezmoi renders them, so each
# shell template is rendered once per host and the output is checked as
# <file>@<host>; line numbers in those findings are the rendered file's. The
# Mac's hostname isn't templated on, so it's rendered as "mac".
set -euo pipefail

# host:os pairs, since templates branch on both
hosts=(masons-xps:linux mac:darwin)
rc=$PWD/.shellcheckrc
# A regex in a variable, since [[ =~ ]] would read an inline \b as a plain b.
sh_shebang='^#!.*[/ ](ba)?sh([[:space:]]|$)'
files=() templates=()
while IFS= read -r -d '' f; do
	# tr keeps the fonts' null bytes out of the command substitution. LC_ALL=C
	# has it read bytes, since macOS's tr rejects the fonts' invalid UTF-8.
	first=$(head -c 128 "$f" | LC_ALL=C tr -d '\0')
	first=${first%%$'\n'*}
	case "$f" in
	*.tmpl)
		if [[ $f == dot_bash*.tmpl || $f == *.sh.tmpl || $first =~ $sh_shebang ]]; then
			templates+=("$f")
		fi
		;;
	*) [[ $first =~ $sh_shebang ]] && files+=("$f") ;;
	esac
done < <(git ls-files -z)

status=0
shellcheck --rcfile "$rc" "${files[@]}" || status=1

rendered=$(mktemp -d)
trap 'rm -rf "$rendered"' EXIT
names=()
for f in "${templates[@]}"; do
	for pair in "${hosts[@]}"; do
		h=${pair%%:*} os=${pair#*:}
		out=$rendered/${f//\//__}@$h
		chezmoi execute-template --source "$PWD" \
			--override-data "{\"chezmoi\":{\"hostname\":\"$h\",\"os\":\"$os\"}}" <"$f" >"$out"
		# A template can render to nothing on a host it doesn't apply to.
		[ -s "$out" ] && names+=("${out##*/}")
	done
done
# The dotfiles have no shebang, so tell shellcheck they're bash.
(cd "$rendered" && shellcheck --rcfile "$rc" --shell=bash "${names[@]}") || status=1
echo "shellcheck: ${#files[@]} scripts, ${#names[@]} rendered templates"

exit $status
