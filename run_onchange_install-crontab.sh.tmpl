#!/bin/bash
# Stop the carpenter dev servers nightly, since an idle one grows to ~1.3 GB
# and never shrinks back. `make` in a Code slot starts its server again.
crontab - <<'EOF'
0 4 * * * /mnt/ebs/home/mmcelvain/Code/Exec/pm2 stop all >/dev/null 2>&1
EOF
