CLAUDE.md

{{/* The ntfy subscriber only earns its keep on a host that has both a desktop
     session to raise notifications on and a topic to listen to. cominor
     publishes to the topic but has nothing to show a popup with. */}}
{{ if or (not (hasKey . "ntfy")) (ne .chezmoi.hostname "masons-xps") -}}
.config/ntfy/client.yml
{{ end -}}

{{ if ne .chezmoi.hostname "masons-xps" -}}
.ssh/config
.config/xdg-terminals.list
.local/share/gnome-shell
{{ end -}}

{{/* The skill symlink resolves its target by running `hunk skill path`, which
     would fail the whole apply on a host that hasn't installed hunk yet. */}}
{{ if not (lookPath "hunk") -}}
.claude/skills/hunk-review
{{ end -}}

{{/* proj works over the Code/ slots, which only exist on cominor. */}}
{{ if ne .chezmoi.hostname "cominor" -}}
.local/bin/proj
.local/bin/proj-claude
{{ end -}}
