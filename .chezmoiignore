CLAUDE.md

{{ if ne .chezmoi.hostname "masons-xps" -}}
.config/xdg-terminals.list
.local/bin/bat
.local/bin/debug-touchpad
.local/share/gnome-shell
{{ end -}}

{{/* Mac terminals start login shells, which read ~/.bash_profile and never
     ~/.bashrc. On Ubuntu one would shadow ~/.profile. */}}
{{ if ne .chezmoi.os "darwin" -}}
.bash_profile
{{ end -}}

{{/* skhd is a macOS hotkey daemon. */}}
{{ if ne .chezmoi.os "darwin" -}}
.config/skhd
.claude/skills/skhd
{{ end -}}

{{/* The ssh config uses UseKeychain, which only macOS's ssh understands. */}}
{{ if ne .chezmoi.os "darwin" -}}
.ssh
{{ end -}}

{{/* The screencast mover is a launchd agent. */}}
{{ if ne .chezmoi.os "darwin" -}}
Library
{{ end -}}

{{/* gpg-agent.conf points at pinentry-mac, which only exists on the Mac. */}}
{{ if ne .chezmoi.os "darwin" -}}
.gnupg
{{ end -}}

{{/* The Mac is an allowlist: it only gets what's named here, so new Linux files
     never reach it by default. A directory has to be un-ignored before anything
     inside it can be. */}}
{{ if eq .chezmoi.os "darwin" -}}
*
.config/*
.local/*
.local/bin/*
.gnupg/*
.ssh/*
Library/*
Library/LaunchAgents/*
!.bashrc
!.bash_profile
!.bash_aliases
!.bash_keybindings
!.gitconfig
!.gitmessage
!.gnupg
!.gnupg/gpg-agent.conf
!.ssh
!.ssh/config
!.config
!.config/git
!.config/helix
!.config/zellij
!.config/alacritty
!.config/skhd
!.config/starship.toml
!.claude
!.claude/**
!.local
!.local/bin
!.local/bin/hx-fmt
!.local/bin/hx-open
!.local/bin/hx-theme.sh
!.local/bin/git-blame-trace.sh
!.local/bin/git-line-commit.sh
!.local/bin/notify
!install-mac-fonts.sh
!build-mm.sh
!configure-mac-screencapture.sh
!Library
!Library/LaunchAgents
!Library/LaunchAgents/local.move-screencasts.plist
{{ end -}}

{{/* The skill symlink resolves its target by running `hunk skill path`, which
     would fail the whole apply on a host that hasn't installed hunk yet. */}}
{{ if not (lookPath "hunk") -}}
.claude/skills/hunk-review
{{ end -}}

{{/* The Jira skill drives acli, Atlassian's CLI, which only the Mac has. */}}
{{ if not (lookPath "acli") -}}
.claude/skills/jira
{{ end -}}

{{/* Nordic Naturals is the work on the Mac, and ship, with its agent roster,
     only ships to its Jira and Bitbucket. */}}
{{ if ne .chezmoi.os "darwin" -}}
.claude/skills/nordic
.claude/skills/ship
.claude/agents/builder.md
.claude/agents/finding-verifier.md
.claude/agents/qa-engineer.md
.claude/agents/review-*.md
{{ end -}}

{{/* Only a host with a Bitbucket address in chezmoi.toml gets its git identity. */}}
{{ if not (hasKey .gitconfig "bitbucketEmail") -}}
.config/git/bitbucket.gitconfig
{{ end -}}

{{/* mm's Go source; run_onchange_before_build-mm.sh builds it into
     ~/.local/bin instead. */}}
mm
