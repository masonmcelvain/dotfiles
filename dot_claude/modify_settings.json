#!/bin/bash
# chezmoi modify script for ~/.claude/settings.json: merge in the agent-status
# hook registrations without managing the rest of the file, which Claude Code
# live-edits (permission grants, plugins, etc.).
# Receives the current target contents on stdin; prints the new contents.
#
# The hook command is host-agnostic: agent-status.sh works out its own zellij
# context.

set -euo pipefail

status_cmd="$HOME/.local/bin/agent-status.sh"

managed=$(jq -n --arg status "$status_cmd" '
    {type: "command", command: $status, timeout: 10} as $agent |
    {
        SessionStart:     [{hooks: [$agent]}],
        UserPromptSubmit: [{hooks: [$agent]}],
        Notification: [
            {matcher: "permission_prompt|idle_prompt|elicitation_dialog|agent_needs_input",
             hooks: [$agent]}
        ],
        PostToolUse:      [{matcher: "*", hooks: [$agent]}],
        Stop:             [{hooks: [$agent]}],
        SessionEnd:       [{hooks: [$agent]}]
    }')

current=$(cat)
[ -n "$current" ] || current='{}'

# For each managed event: drop any entry we own, then append the current set.
# "Ours" still covers the notify, notify-send, and curl-to-ntfy commands, so
# applying it strips any notification hooks left over in settings.json. Idempotent; every other hook and setting is left untouched.
jq --argjson managed "$managed" '
    def is_managed:
        (.hooks // []) | any(
            (.command // "") | test("agent-status\\.sh|notify-send|ntfy\\.sh|/notify( |$)")
        );
    .hooks = (
        reduce ($managed | to_entries[]) as $e (.hooks // {};
            .[$e.key] = ((.[$e.key] // [] | map(select(is_managed | not))) + $e.value))
    )
' <<<"$current"
