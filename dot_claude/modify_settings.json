#!/bin/bash
# chezmoi modify script for ~/.claude/settings.json: merge in the agent-status
# (`mm agent-status`) and notification hook registrations without managing the
# rest of the file, which Claude Code live-edits (permission grants, plugins,
# etc.).
# Receives the current target contents on stdin; prints the new contents.
#
# Both hook commands are host-agnostic: mm agent-status works out its own
# zellij context, and notify works out how to reach the desktop. The
# agent-status hooks are only registered where mm is installed, since it isn't
# built on macOS; run_onchange_before_build-mm.sh builds it before this runs.

set -euo pipefail

status_cmd="$HOME/.local/bin/mm agent-status"
notify_cmd="$HOME/.local/bin/notify"

has_mm=false
[ -x "${status_cmd%% *}" ] && has_mm=true

managed=$(jq -n --arg status "$status_cmd" --arg notify "$notify_cmd" --argjson has_mm "$has_mm" '
    {type: "command", command: $status, timeout: 10} as $agent |
    # Messages are single-quoted for the shell; keep them apostrophe-free.
    def say($msg): {
        type: "command",
        command: "\($notify) -a claude -n claude-desktop '"'"'Claude Code'"'"' '"'"'\($msg)'"'"'"
    };
    {
        SessionStart:     [{hooks: [$agent]}],
        UserPromptSubmit: [{hooks: [$agent]}],
        Notification: [
            {matcher: "permission_prompt",    hooks: [say("Permission requested")]},
            {matcher: "auth_success",         hooks: [say("Authentication successful")]},
            {matcher: "elicitation_dialog",   hooks: [say("MCP tool needs your input")]},
            {matcher: "permission_prompt|idle_prompt|elicitation_dialog|agent_needs_input",
             hooks: [$agent]}
        ],
        PostToolUse:      [{matcher: "*", hooks: [$agent]}],
        Stop:             [{hooks: [say("Task completed")]}, {hooks: [$agent]}],
        SessionEnd:       [{hooks: [$agent]}]
    }
    # Without mm, drop the agent-status entries and the events left empty.
    | if $has_mm then . else
        map_values(map(select(.hooks | any(.command == $status) | not)))
        | with_entries(select(.value != []))
      end')

current=$(cat)
[ -n "$current" ] || current='{}'

# For each managed event: drop any entry we own, then append the current set.
# "Ours" covers the notify-send commands this script replaced,
# and the agent-status.sh that mm replaced, so applying it migrates the old
# hooks rather than duplicating them. Idempotent; every other hook and setting is left untouched.
jq --argjson managed "$managed" '
    def is_managed:
        (.hooks // []) | any(
            (.command // "") | test("agent-status\\.sh|/mm agent-status$|notify-send|/notify( |$)")
        );
    .hooks = (
        reduce ($managed | to_entries[]) as $e (.hooks // {};
            .[$e.key] = ((.[$e.key] // [] | map(select(is_managed | not))) + $e.value))
    )
' <<<"$current"
