[general]
{{ if eq .chezmoi.os "darwin" -}}
# Nothing on the Mac swaps theme.toml with the system appearance the way
# theme-monitor.sh does under GNOME, so import a theme directly.
import = ["{{ .chezmoi.homeDir }}/.config/alacritty/everforest_light.toml"]
{{- else -}}
import = ["{{ .chezmoi.homeDir }}/.config/alacritty/theme.toml"]
{{- end }}

{{ if eq .chezmoi.os "darwin" -}}
# Linux reaches this font through fontconfig's monospace alias, which macOS
# doesn't have, so name it here. run_onchange_install-mac-fonts.sh installs it.
[font]
normal = { family = "Liga SFMono Nerd Font" }
# Up from the 11.25 default, which reads small on the Mac's display.
size = 14

{{ end -}}
[[keyboard.bindings]]
action = "Quit"
key = "W"
mods = "Control|Shift"

[[keyboard.bindings]]
action = "ToggleViMode"
key = "Q"
mode = "Vi"

[[keyboard.bindings]]
action = "Last"
key = 5
mode = "Vi|~Search"
mods = "Shift"

[mouse]
hide_when_typing = true

[selection]
save_to_clipboard = true

[window]
dynamic_title = false
title = ""
{{- if eq .chezmoi.os "darwin" }}
# Send Option as Alt rather than typing characters like å, so zellij's and
# helix's Alt bindings work as they do on Linux.
option_as_alt = "Both"
{{- end }}

[window.dimensions]
columns = 80
lines = 25
