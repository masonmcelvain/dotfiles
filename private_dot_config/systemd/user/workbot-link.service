[Unit]
Description=Keep an ssh ControlMaster to cominor open for workbot and gpg signing
Documentation=https://github.com/masonmcelvain/workbot
After=network-online.target
ConditionHost=masons-xps

[Service]
Type=simple
# The hub's polls ride on this master (%t/workbot-ssh-cominor), and the
# RemoteForward in ssh config puts the laptop's gpg-agent on cominor through
# it. It is separate from the shells' master, so restarting it drops no
# session.
#
# A fresh connection needs the gpg-agent to unlock the ssh key, which from a
# daemon means a pinentry prompt on the desktop, so it only connects while
# the key is already unlocked (KEYINFO's cached flag); workbot-link.timer
# retries until it is. The remote loop exits as soon as the forwarded gpg
# socket stops answering (another connection re-bound it and closed), and
# the restart binds it again.
ExecCondition=/bin/sh -c "gpg-connect-agent 'keyinfo --ssh-list' /bye | grep -q ' 1 P '"
ExecStartPre=-/bin/rm -f %t/workbot-ssh-cominor
ExecStart=/usr/bin/ssh -o ControlMaster=yes -o ControlPath=%t/workbot-ssh-cominor -o ControlPersist=no -o BatchMode=yes -o ExitOnForwardFailure=yes cominor 'while gpg-connect-agent --no-autostart "getinfo version" /bye >/dev/null 2>&1; do sleep 60; done'
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
