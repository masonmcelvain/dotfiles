# Subscriber for the ntfy topic that `notify` publishes to. Read by
# ntfy-client.service, a user unit shipped by the ntfy package:
#   systemctl --user status ntfy-client
#
# This is the other half of ~/.local/bin/notify. A machine with no desktop
# session (cominor) can't raise a notification itself, so it publishes to
# ntfy.sh instead; this holds a long-lived stream to that topic and replays
# each message through notify-send here. A phone subscribed to the same topic
# is an independent second subscriber.
#
# Only managed on hosts that have both a desktop to notify and a topic
# configured -- see .chezmoiignore. Restart the unit after changing this.
#
# The topic is a bearer secret, so it comes from chezmoi's config data
# (~/.config/chezmoi/chezmoi.toml) rather than the public dotfiles repo.

subscribe:
  - topic: {{ .ntfy.topic }}
    # $t and $m are the publisher's title and body; $p is priority 1-5, which
    # notify sets from its own -u. The title carries the interesting part (the
    # command and its status), prefixed by notify with the host it came from.
    #
    # A high-priority push maps to the error icon rather than critical
    # urgency: GNOME Shell never times out a critical banner, so a failed
    # build on cominor would sit on screen until clicked.
    command: >-
      case "$p" in
      4|5) u=normal i=dialog-error;;
      1|2) u=low i=dialog-information;;
      *) u=normal i=dialog-information;;
      esac;
      notify-send -a ntfy -u "$u" -i "$i" "${t:-Notification}" "$m"
