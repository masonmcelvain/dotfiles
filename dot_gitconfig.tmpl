[alias]
   ap    = add -p
   bl    = blame --color-lines
	co    = checkout
	ci    = commit
	cia    = commit --amend
	cinit = commit --allow-empty -m 'initial commit'
   cp    = cherry-pick
   d     = diff
   ds    = diff --staged
   dh    = diff HEAD^ HEAD
	st    = status
	br    = branch
   l     = log
   logo  = log --oneline
   rb    = rebase
   rbc   = rebase --continue
   rbi   = "!f() { git rebase -i \"HEAD~$1\"; }; f"
   rs    = restore
   rsa   = restore '*'
   rss   = restore '*' --staged
	sl    = stash list
	su    = stash -u
	sp    = stash pop
   sw    = switch
[branch]
	autosetupmerge = simple
	autosetuprebase = always
[user]
	signingkey = {{ .gitconfig.signingkey }}
	name = Mason McElvain
   email = {{ .gitconfig.email | quote }}
   useConfigOnly = true
{{- if hasKey .gitconfig "bitbucketEmail" }}
[includeIf "hasconfig:remote.*.url:git@ssh.bitbucket.org:*/**"]
	path = ~/.config/git/bitbucket.gitconfig
[includeIf "hasconfig:remote.*.url:git@bitbucket.org:*/**"]
	path = ~/.config/git/bitbucket.gitconfig
[includeIf "hasconfig:remote.*.url:https://*@bitbucket.org/**"]
	path = ~/.config/git/bitbucket.gitconfig
[includeIf "hasconfig:remote.*.url:https://bitbucket.org/**"]
	path = ~/.config/git/bitbucket.gitconfig
{{- end }}
[init]
	defaultBranch = main
[commit]
	gpgsign = true
	template = ~/.gitmessage
[core]
	editor = hx
[gpg]
   program = {{ if eq .chezmoi.os "darwin" }}gpg{{ else }}gpg2{{ end }}
{{- if eq .chezmoi.os "darwin" }}
# Push over HTTPS with gh's login. The empty helper skips Homebrew git's
# osxkeychain, which has no GitHub token and would prompt for a username.
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
{{- end }}
[pull]
	rebase = false
[push]
	autoSetupRemote = true

# https://github.com/dandavison/delta
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true    # use n and N to move between diff sections
[include]
    path = ~/.config/git/theme.gitconfig # written by theme-monitor.sh
[merge]
    conflictstyle = diff3
[diff]
    colorMoved = no
[help]
	autocorrect = prompt
